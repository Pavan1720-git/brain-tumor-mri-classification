# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter checkpoints ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE files ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── TensorFlow / Keras logs ──────────────────────────────────────────────────
logs/
*.tfevents.*

